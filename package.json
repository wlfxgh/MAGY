{
  "name": "magy",
  "displayName": "MAGY",
  "description": "在 Visual Studio Code 与 Cursor 的侧边栏中，通过 ACP 使用随扩展安装的反重力。代理同时用于官方运行时下载和对话连接。编辑器中的选中代码可加入当前对话。Cursor 中的既有对话可只读引入并继续，原记录保持不变。",
  "version": "0.2.0",
  "engines": {
    "vscode": "^1.128.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "magy",
          "title": "MAGY",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "magy": [
        {
          "type": "webview",
          "id": "magy.chat",
          "name": "对话",
          "contextualTitle": "MAGY"
        }
      ]
    },
    "commands": [
      {
        "command": "magy.focus",
        "title": "打开 MAGY 侧边栏",
        "category": "MAGY"
      },
      {
        "command": "magy.showHistory",
        "title": "历史对话",
        "category": "MAGY",
        "icon": "$(history)"
      },
      {
        "command": "magy.newChat",
        "title": "新建对话",
        "category": "MAGY",
        "icon": "$(add)"
      },
      {
        "command": "magy.importCursorChat",
        "title": "引入 Cursor 对话",
        "category": "MAGY",
        "icon": "$(inbox)"
      },
      {
        "command": "magy.addSelection",
        "title": "添加到 MAGY 对话",
        "category": "MAGY",
        "icon": "$(code)"
      },
      {
        "command": "magy.addPath",
        "title": "将路径添加到 MAGY 对话",
        "category": "MAGY",
        "icon": "$(file-add)"
      },
      {
        "command": "magy.installRuntime",
        "title": "安装或更新内置反重力",
        "category": "MAGY"
      },
      {
        "command": "magy.setApiKey",
        "title": "设置 Gemini API Key",
        "category": "MAGY"
      },
      {
        "command": "magy.toggleSkipPermissions",
        "title": "切换跳过权限模式 (--dangerously-skip-permissions)",
        "category": "MAGY"
      },
      {
        "command": "magy.openSettings",
        "title": "打开设置",
        "category": "MAGY",
        "icon": "$(gear)"
      },
      {
        "command": "magy.showUsage",
        "title": "查看剩余用量与 Token 统计",
        "category": "MAGY",
        "icon": "$(dashboard)"
      },
      {
        "command": "magy.moveView",
        "title": "移动视图位置（可移至右侧辅助栏）",
        "category": "MAGY"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "magy.addPath",
          "group": "navigation@20"
        }
      ],
      "editor/title/context": [
        {
          "command": "magy.addPath",
          "group": "navigation@20"
        }
      ],
      "editor/context": [
        {
          "command": "magy.addSelection",
          "when": "editorHasSelection",
          "group": "navigation@20"
        },
        {
          "command": "magy.addPath",
          "when": "!editorHasSelection",
          "group": "navigation@20"
        }
      ],
      "view/title": [
        {
          "command": "magy.moveView",
          "when": "view == magy.chat",
          "group": "1_layout@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "magy.addSelection",
        "key": "ctrl+alt+l",
        "mac": "cmd+alt+l",
        "when": "editorTextFocus && editorHasSelection"
      }
    ],
    "configuration": {
      "title": "MAGY",
      "properties": {
        "magy.proxy": {
          "type": "string",
          "default": "",
          "markdownDescription": "扩展内的 HTTP 代理，例如 `http://127.0.0.1:7890`。官方发布清单、反重力安装包下载，以及反重力进程的 `HTTP_PROXY`、`HTTPS_PROXY`、`ALL_PROXY` 都使用这个地址。留空时，依次使用编辑器的 `http.proxy` 和环境变量中已有的代理。"
        },
        "magy.noProxy": {
          "type": "string",
          "default": "localhost,127.0.0.1,::1",
          "markdownDescription": "设置了 `magy.proxy` 时不走代理的主机。下载和反重力进程都遵守这份名单。"
        },
        "magy.binaryPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "留空时使用插件存储目录中的反重力，不读取系统 PATH。仅在需要指定其他可执行文件时填写。"
        },
        "magy.sandbox": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "为 `agy acp` 附加 `--sandbox`。"
        },
        "magy.dangerouslySkipPermissions": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "开启后为 `agy acp` 附加 `--dangerously-skip-permissions`，自动跳过所有编辑、命令与工具权限确认。"
        },
        "magy.extraArgs": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "markdownDescription": "附加在 `acp` 之后的其他自定义参数。"
        },
        "magy.cursorDataDir": {
          "type": "string",
          "default": "",
          "markdownDescription": "Cursor 用户目录，只用于读取对话。留空时按当前操作系统的默认位置查找。"
        },
        "magy.fontSize": {
          "type": "number",
          "default": 14,
          "minimum": 11,
          "maximum": 22,
          "markdownDescription": "侧边栏默认字体大小（单位：px，范围 11–22，默认 14）。"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./ && tsc -p tsconfig.webview.json --noEmit && node esbuild.mjs",
    "compile:webview": "tsc -p tsconfig.webview.json --noEmit && node esbuild.mjs",
    "watch": "node esbuild.mjs --watch --with-tsc",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.146.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}

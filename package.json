{
  "name": "magy",
  "displayName": "MAGY",
  "description": "在 VS Code 和 Cursor 侧边栏中集成 Antigravity (ACP) 的 AI 编程助手，支持代码上下文引用、交互式问答、用量统计与 Cursor 对话导入。",
  "version": "0.2.0",
  "publisher": "wlfxgh",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/wlfxgh/MAGY.git"
  },
  "homepage": "https://github.com/wlfxgh/MAGY#readme",
  "bugs": {
    "url": "https://github.com/wlfxgh/MAGY/issues"
  },
  "galleryBanner": {
    "color": "#111827",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "keywords": [
    "ai",
    "agent",
    "acp",
    "antigravity",
    "gemini",
    "cursor",
    "chat"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "magy",
          "title": "MAGY",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "magy": [
        {
          "type": "webview",
          "id": "magy.chat",
          "name": "对话",
          "contextualTitle": "MAGY"
        }
      ]
    },
    "commands": [
      {
        "command": "magy.focus",
        "title": "打开 MAGY 侧边栏",
        "category": "MAGY"
      },
      {
        "command": "magy.showHistory",
        "title": "历史对话",
        "category": "MAGY",
        "icon": "$(history)"
      },
      {
        "command": "magy.newChat",
        "title": "新建对话",
        "category": "MAGY",
        "icon": "$(add)"
      },
      {
        "command": "magy.importCursorChat",
        "title": "引入 Cursor 对话",
        "category": "MAGY",
        "icon": "$(inbox)"
      },
      {
        "command": "magy.addSelection",
        "title": "添加到 MAGY 对话",
        "category": "MAGY",
        "icon": "$(code)"
      },
      {
        "command": "magy.addPath",
        "title": "将路径添加到 MAGY 对话",
        "category": "MAGY",
        "icon": "$(file-add)"
      },
      {
        "command": "magy.installRuntime",
        "title": "安装或更新内置反重力",
        "category": "MAGY"
      },
      {
        "command": "magy.setApiKey",
        "title": "设置 Gemini API Key",
        "category": "MAGY"
      },
      {
        "command": "magy.toggleSkipPermissions",
        "title": "切换跳过权限模式 (--dangerously-skip-permissions)",
        "category": "MAGY"
      },
      {
        "command": "magy.openSettings",
        "title": "打开设置",
        "category": "MAGY",
        "icon": "$(gear)"
      },
      {
        "command": "magy.showUsage",
        "title": "查看剩余用量与 Token 统计",
        "category": "MAGY",
        "icon": "$(dashboard)"
      },
      {
        "command": "magy.moveView",
        "title": "移动视图位置（可移至右侧辅助栏）",
        "category": "MAGY"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "magy.addPath",
          "group": "navigation@20"
        }
      ],
      "editor/title/context": [
        {
          "command": "magy.addPath",
          "group": "navigation@20"
        }
      ],
      "editor/context": [
        {
          "command": "magy.addSelection",
          "when": "editorHasSelection",
          "group": "navigation@20"
        },
        {
          "command": "magy.addPath",
          "when": "!editorHasSelection",
          "group": "navigation@20"
        }
      ],
      "view/title": [
        {
          "command": "magy.moveView",
          "when": "view == magy.chat",
          "group": "1_layout@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "magy.addSelection",
        "key": "ctrl+alt+l",
        "mac": "cmd+alt+l",
        "when": "editorTextFocus && editorHasSelection"
      }
    ],
    "configuration": {
      "title": "MAGY",
      "properties": {
        "magy.proxy": {
          "type": "string",
          "default": "",
          "markdownDescription": "HTTP 代理地址（例如 `http://127.0.0.1:7890`），用于运行时下载、认证与代理进程；留空时继承编辑器 `http.proxy` 及系统环境变量。"
        },
        "magy.noProxy": {
          "type": "string",
          "default": "localhost,127.0.0.1,::1",
          "markdownDescription": "不走代理的主机列表，下载与代理进程均遵守该配置。"
        },
        "magy.binaryPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "自定义 Antigravity 可执行文件路径；留空时使用扩展全局存储目录中的内置运行时。"
        },
        "magy.sandbox": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "启动 `agy acp` 时附加 `--sandbox` 参数。"
        },
        "magy.dangerouslySkipPermissions": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "启用后为 `agy acp` 附加 `--dangerously-skip-permissions`，自动跳过工具、编辑与命令权限确认。"
        },
        "magy.extraArgs": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "markdownDescription": "附加在 `acp` 子命令之后的自定义命令行参数。"
        },
        "magy.cursorDataDir": {
          "type": "string",
          "default": "",
          "markdownDescription": "本地 Cursor 用户数据目录（只读读取对话记录）；留空时按系统默认路径查找。"
        },
        "magy.fontSize": {
          "type": "number",
          "default": 14,
          "minimum": 11,
          "maximum": 22,
          "markdownDescription": "侧边栏字体大小（单位：px，范围 11–22，默认 14）。"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./ && tsc -p tsconfig.webview.json --noEmit && node esbuild.mjs",
    "compile:webview": "tsc -p tsconfig.webview.json --noEmit && node esbuild.mjs",
    "watch": "node esbuild.mjs --watch --with-tsc",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "package": "vsce package",
    "publish:vsce": "vsce publish",
    "publish:ovsx": "npx ovsx publish"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.120.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
